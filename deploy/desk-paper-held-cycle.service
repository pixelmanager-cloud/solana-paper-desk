[Unit]
Description=One bounded positions-only unverified paper monitoring pass (inactive template)
ConditionPathExists=/var/lib/solana-desk/active-paper.sqlite
After=network-online.target
[Service]
Type=oneshot
User=solana-desk
Group=solana-desk
WorkingDirectory=/opt/solana-desk
LoadCredential=provider-keys.json:/etc/solana-desk/provider-keys.json
ExecStart=/opt/solana-desk/.venv/bin/python -m desk.paper_monitor_service --config /opt/solana-desk/config/paper-quote-reviewed.json --research-db /var/lib/solana-desk/research.sqlite --evidence-db /var/lib/solana-desk/evidence.sqlite --ledger-db /var/lib/solana-desk/active-paper.sqlite --pool-fee-bps 25 --systemd-credentials --dependency-blocker RUNTIME_REVIEW_AND_PATH_BINDINGS_REQUIRED
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/solana-desk
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=20
MemoryMax=384M
TasksMax=32
# No Install section: not enabled by installation. No Restart/retry.
# Coordinator must replace ExecStart only after exact dependency/path/config/fee review.
# 25 is an explicit example hypothesis, never a verified route fee.
