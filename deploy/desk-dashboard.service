[Unit]
Description=Solana desk local research dashboard
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=solana-desk
Group=solana-desk
WorkingDirectory=/opt/solana-desk
Environment=DESK_PAPER_SCHEDULER_LOCK=/var/lib/solana-desk/paper-scheduler.lock
LoadCredential=provider-keys.json:/etc/solana-desk/provider-keys.json
ExecStart=/opt/solana-desk/.venv/bin/python -m desk --secrets-file %d/provider-keys.json serve --db /var/lib/solana-desk/research.sqlite --port 8765
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/solana-desk
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=384M
TasksMax=32
[Install]
WantedBy=multi-user.target
