[Unit]
Description=Solana desk bounded read-only Helius recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=solana-desk
Group=solana-desk
WorkingDirectory=/opt/solana-desk
LoadCredential=provider-keys.json:/etc/solana-desk/provider-keys.json
ExecStart=/opt/solana-desk/.venv/bin/python -m desk --secrets-file %d/provider-keys.json record --db /var/lib/solana-desk/raw.sqlite --seconds 60 --max-records 1000 --max-bytes 20000000
StateDirectory=solana-desk
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/solana-desk
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=100

# Deliberately no timer/restart loop: measure one capture's cost before continuous ingestion.
