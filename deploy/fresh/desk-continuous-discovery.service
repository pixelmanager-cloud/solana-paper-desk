# Long-running migration discovery. listen exits cleanly after its 86400 s bound (discovery/continuous.py
# caps --seconds at 86400); Restart=always re-enters it with the same persistent budgets (nothing resets).
[Unit]
Description=Continuous migration discovery (no investigations or entries)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=10
[Service]
Type=simple
User=solana-desk
Group=solana-desk
WorkingDirectory=<RELEASE_DIR>
LoadCredential=provider-keys.json:/etc/solana-desk/provider-keys.json
ExecStart=/opt/solana-desk/.venv/bin/python -m discovery.continuous listen --db <DISCOVERY_DB> --seconds 86400
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=<DISCOVERY_DIR>
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=128M
TasksMax=16
TimeoutStopSec=35
[Install]
WantedBy=multi-user.target
