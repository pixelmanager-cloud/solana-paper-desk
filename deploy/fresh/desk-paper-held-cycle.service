# One bounded positions-only monitoring/exit pass. Same config and ledger as the entry unit.
# Never add a dependency-blocker flag: it exits 2 without attempting any exit.
[Unit]
Description=One bounded held-position paper pass
After=network-online.target
Wants=network-online.target
ConditionPathExists=<FRESH_ROOT>/paper-scheduler.lock
ConditionPathExists=<FRESH_ROOT>/paper-ledger.sqlite
[Service]
Type=oneshot
User=solana-desk
Group=solana-desk
WorkingDirectory=<RELEASE_DIR>
Environment=DESK_PROVIDER_PACING_DB=<PACING_DB>
Environment=DESK_PAPER_SCHEDULER_IDENTITY=<SCHEDULER_IDENTITY>
LoadCredential=provider-keys.json:/etc/solana-desk/provider-keys.json
ExecStart=/opt/solana-desk/.venv/bin/python -m tools.paper_scheduler --research-db <FRESH_ROOT>/research.sqlite --mode held -- --config <CONFIG> --research-db <FRESH_ROOT>/research.sqlite --evidence-db <FRESH_ROOT>/evidence.sqlite --ledger-db <FRESH_ROOT>/paper-ledger.sqlite --pool-fee-bps <POOL_FEE_BPS> --systemd-credentials --wall-seconds 64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=<FRESH_ROOT> <PACING_DIR>
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=120
MemoryMax=384M
TasksMax=32
