# Stale-mark watchdog (no network, no quotes, no fills). NOT enabled by default: with a slow held cadence
# it flags every position stale and mode sticks at EXIT_ONLY (T09 F5). Enable only after that is resolved.
[Unit]
Description=Expire stale paper marks without prices or fills
ConditionPathExists=<FRESH_ROOT>/paper-scheduler.lock
ConditionPathExists=<FRESH_ROOT>/paper-ledger.sqlite
[Service]
Type=oneshot
User=solana-desk
Group=solana-desk
WorkingDirectory=<RELEASE_DIR>
Environment=DESK_PAPER_SCHEDULER_IDENTITY=<SCHEDULER_IDENTITY>
ExecStart=/opt/solana-desk/.venv/bin/python -m tools.paper_scheduler --research-db <FRESH_ROOT>/research.sqlite --mode expire -- --db <FRESH_ROOT>/paper-ledger.sqlite --config <CONFIG>
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=<FRESH_ROOT>
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=true
TimeoutStartSec=60
MemoryMax=128M
