# Loopback only: desk.dashboard.serve binds 127.0.0.1 (hard-coded). Never add a host/bind option.
[Unit]
Description=Solana desk local research dashboard (loopback)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10
[Service]
Type=simple
User=solana-desk
Group=solana-desk
WorkingDirectory=<RELEASE_DIR>
Environment=DESK_PAPER_SCHEDULER_LOCK=<FRESH_ROOT>/paper-scheduler.lock
LoadCredential=provider-keys.json:/etc/solana-desk/provider-keys.json
ExecStart=/opt/solana-desk/.venv/bin/python -m desk --secrets-file %d/provider-keys.json serve --db <FRESH_ROOT>/research.sqlite --port 8765
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=<FRESH_ROOT>
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=384M
TasksMax=32
[Install]
WantedBy=multi-user.target
